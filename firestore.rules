rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ログイン前にも更新案内を取得する。変更は管理者からのみ行う。
    match /appUpdates/{configId} {
      allow get: if true;
      allow list, write: if false;
    }

    // 自分と otherUid が連携済みかどうかを確認する
    // linkId は2つのUIDをソートして _ でつないだもの（AccountLinkRepositoryImpl._linkIdOf と同一）
    function isLinkedWith(otherUid) {
      let linkId = request.auth.uid < otherUid
        ? request.auth.uid + '_' + otherUid
        : otherUid + '_' + request.auth.uid;
      return exists(/databases/$(database)/documents/accountLinks/$(linkId));
    }

    // users/{uid}: 連携相手の表示名・共有設定を引けるよう単一取得(get)のみログイン済み全員に許可
    // 一覧(list)は禁止して全ユーザーの列挙を防ぐ。FCMトークンは users/{uid}/private/fcm（オーナーのみ）に置く
    // users/{uid} の値の型・長さの検証
    function validUserValues(data) {
      return (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 50))
        && (!('shareWantToGo' in data) || data.shareWantToGo is bool)
        && (!('shareVisited' in data) || data.shareVisited is bool)
        && (!('walkingStatus' in data) || data.walkingStatus == 'walking');
    }

    // 書き込めるフィールドは許可リストのみ
    match /users/{uid} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt', 'shareWantToGo', 'shareVisited', 'walkingStatus'])
        && validUserValues(request.resource.data);
      // fcmToken は旧仕様の残骸を削除するために更新対象として許可する
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt', 'shareWantToGo', 'shareVisited', 'walkingStatus', 'fcmToken'])
        && validUserValues(request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid}/contacts, spots, photos などサブコレクションはオーナーのみ
    // （{uid} 直下のドキュメント自体にはマッチさせない）
    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // 連携済みユーザーは相手の共有設定に応じてスポットを読み取り可
    match /users/{uid}/spots/{spotId} {
      // 単一取得: ステータスに対応する共有設定を確認（フィールド未設定はデフォルトON）
      allow get: if isSignedIn()
        && isLinkedWith(uid)
        && (
          (resource.data.status == 'wantToGo'
            && get(/databases/$(database)/documents/users/$(uid)).data.get('shareWantToGo', true) != false)
          || (resource.data.status == 'visited'
            && get(/databases/$(database)/documents/users/$(uid)).data.get('shareVisited', true) != false)
        );
      // コレクションクエリ: クエリが status で絞られている場合のみ、そのステータスの共有設定を確認する
      // （クライアントは共有ONのステータスごとに where('status', isEqualTo: ...) で取得する）
      allow list: if isSignedIn()
        && isLinkedWith(uid)
        && (
          (resource.data.status == 'wantToGo'
            && get(/databases/$(database)/documents/users/$(uid)).data.get('shareWantToGo', true) != false)
          || (resource.data.status == 'visited'
            && get(/databases/$(database)/documents/users/$(uid)).data.get('shareVisited', true) != false)
        );
    }

    match /linkInvites/{token} {
      // トークン（ドキュメントID）を知っている場合のみ取得可。一覧は禁止して未使用招待の収集を防ぐ
      allow get: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.used == false;

      allow update: if isSignedIn()
        && resource.data.fromUid != request.auth.uid
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']);

      allow delete: if false;
    }

    match /accountLinks/{linkId} {
      // resource == null は未作成ドキュメントの存在確認（連携済みチェック）を許可する
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.uids);

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() == 2
        && exists(/databases/$(database)/documents/linkInvites/$(request.resource.data.inviteToken))
        && get(/databases/$(database)/documents/linkInvites/$(request.resource.data.inviteToken)).data.fromUid != request.auth.uid
        && get(/databases/$(database)/documents/linkInvites/$(request.resource.data.inviteToken)).data.fromUid in request.resource.data.uids
        && get(/databases/$(database)/documents/linkInvites/$(request.resource.data.inviteToken)).data.used == false
        && get(/databases/$(database)/documents/linkInvites/$(request.resource.data.inviteToken)).data.expiresAt > request.time
        // 同一トランザクションで招待が使用済みにされていることを強制する
        && getAfter(/databases/$(database)/documents/linkInvites/$(request.resource.data.inviteToken)).data.used == true
        // ドキュメントIDが2つのUIDから決まる値であること
        && linkId == (
          request.resource.data.uids[0] < request.resource.data.uids[1]
            ? request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
            : request.resource.data.uids[1] + '_' + request.resource.data.uids[0]
        );

      allow update: if false;

      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
    }
  }
}
