rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ユーザーの写真: オーナーのみ書き込み可、連携ユーザーは読み取り可
    match /users/{uid}/spots/{spotId}/{fileName} {
      // 書き込みはオーナーのみ。画像かつ10MB未満に制限する
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;

      // 削除はオーナーのみ（delete には request.resource がないため write と分ける）
      allow delete: if request.auth != null && request.auth.uid == uid;

      // 読み取りはオーナーと連携済みユーザーのみ
      // accountLinks のドキュメントIDは2つのUIDをソートして _ でつないだもの
      // （firestore.exists は Cross-service rules。デプロイ時に IAM ロール付与の確認が出る）
      allow read: if request.auth != null
        && (request.auth.uid == uid
          || firestore.exists(/databases/(default)/documents/accountLinks/$(
            request.auth.uid < uid
              ? request.auth.uid + '_' + uid
              : uid + '_' + request.auth.uid)));
    }
  }
}
