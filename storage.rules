rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // スポットのステータスに対応する共有設定がONか
    function isShared(share, status) {
      return (status == 'wantToGo' && share.wantToGo == true)
        || (status == 'visited' && share.visited == true);
    }

    // ユーザーの写真: オーナーのみ書き込み可、連携ユーザーは読み取り可
    match /users/{uid}/spots/{spotId}/{fileName} {
      // 書き込みはオーナーのみ。画像かつ10MB未満に制限する
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;

      // 削除はオーナーのみ（delete には request.resource がないため write と分ける）
      allow delete: if request.auth != null && request.auth.uid == uid;

      // 読み取りはオーナー、または連携済みかつ共有対象のスポットを持つユーザーのみ。
      // Storage ルールで参照できる Firestore ドキュメントは1リクエスト2件までのため、
      // 連携(accountLinks)とスポット(users/{uid}/spots/{spotId})の2件に収める。
      // 共有設定は accountLinks.shares.{オーナーUID} に持たせてあり、設定変更時に
      // 1回のバッチで原子的に更新されるため、更新途中の写真が公開されたままになることはない。
      // accountLinks のドキュメントIDは2つのUIDをソートして _ でつないだもの。
      // 連携解除・スポット削除済みなら firestore.get が失敗して拒否になる。
      // （firestore.* は Cross-service rules。デプロイ時に IAM ロール付与の確認が出る）
      allow read: if request.auth != null
        && (request.auth.uid == uid
          || isShared(
            firestore.get(/databases/(default)/documents/accountLinks/$(
              request.auth.uid < uid
                ? request.auth.uid + '_' + uid
                : uid + '_' + request.auth.uid)).data.shares[uid],
            firestore.get(/databases/(default)/documents/users/$(uid)/spots/$(spotId)).data.status));
    }
  }
}
