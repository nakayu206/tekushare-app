rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ユーザーの写真: オーナーのみ書き込み可、連携ユーザーは読み取り可
    match /users/{uid}/spots/{spotId}/{fileName} {
      // 書き込みはオーナーのみ。画像かつ10MB未満に制限する
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;

      // 削除はオーナーのみ（delete には request.resource がないため write と分ける）
      allow delete: if request.auth != null && request.auth.uid == uid;

      // 読み取りはオーナー、または連携済みかつスポットが共有対象のユーザーのみ
      // Storage ルールで参照できる Firestore ドキュメントは1リクエスト2件までのため、
      // 連携(accountLinks) + スポット(users/{uid}/spots/{spotId}) の2件に収める。
      // スポットの shared は、共有設定(users/{uid})とステータスから Cloud Functions
      // (syncSpotShared / syncSharedOnSettingsChange)が算出して書き込む非正規化フィールド。
      // accountLinks のドキュメントIDは2つのUIDをソートして _ でつないだもの。
      // スポットが削除済みなら firestore.get が失敗して拒否になる。
      // （firestore.* は Cross-service rules。デプロイ時に IAM ロール付与の確認が出る）
      allow read: if request.auth != null
        && (request.auth.uid == uid
          || (firestore.exists(/databases/(default)/documents/accountLinks/$(
              request.auth.uid < uid
                ? request.auth.uid + '_' + uid
                : uid + '_' + request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(uid)/spots/$(spotId))
              .data.get('shared', false) == true));
    }
  }
}
